<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <OutputPath Condition="'$(RELOADEDIIMODS)' != ''">$(RELOADEDIIMODS)/GBFR.ChatOverlay</OutputPath>
    <OutputPath Condition="'$(RELOADEDIIMODS)' == ''">bin/$(Configuration)/</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <NativeBridgeConfiguration>Release</NativeBridgeConfiguration>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <InformationalVersion>0.6.0</InformationalVersion>
    <Authors>Kuro</Authors>
    <Description>Native room chat and PlayFab Party voice overlay for Granblue Fantasy: Relink 2.0.4.</Description>
    <RepositoryUrl>https://github.com/cajoxorize366-oss/GBFR.ChatOverlay</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);GBFR_DIAGNOSTICS</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <NativeBridgeConfiguration>Debug</NativeBridgeConfiguration>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);GBFR_RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <NativeBridgeConfiguration>Release</NativeBridgeConfiguration>
  </PropertyGroup>

  <Import Project="Reloaded.Checks.targets" />

  <ItemGroup>
    <None Remove="ModConfig.json" />
    <None Remove="build-native-bridge.ps1" />
    <None Remove="Reloaded.Checks.targets" />
    <Compile Remove="ConfiguratorUI/**/*.cs" />
    <Compile Remove="GBFR.OverlayHub.Contracts/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ModConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licenses/Reloaded.Imgui.Hook-LICENSE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licenses/NAudio-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licenses/HidSharp-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licenses/SafetyHook-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="licenses/Zydis-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="NativeBridge/bin/$(NativeBridgeConfiguration)/GBFR.ChatOverlay.Native.dll"
          Link="GBFR.ChatOverlay.Native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="Reloaded.Imgui.Hook" Version="4.1.0" />
    <PackageReference Include="Reloaded.Imgui.Hook.Direct3D11" Version="1.0.2" />
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Reloaded.SharedLib.Hooks" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="GBFR.OverlayHub.Contracts/GBFR.OverlayHub.Contracts.csproj" />
    <ProjectReference Include="ConfiguratorUI/GBFR.ChatOverlay.ConfiguratorUI.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <ConfiguratorUiTargetPath>$(MSBuildProjectDirectory)/ConfiguratorUI/bin/$(Configuration)/GBFR.ChatOverlay.ConfiguratorUI.dll</ConfiguratorUiTargetPath>
  </PropertyGroup>

  <Target Name="BuildNativePresentBridge"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build-native-bridge.ps1&quot; -Configuration $(NativeBridgeConfiguration)" />
  </Target>

  <Target Name="CopyConfiguratorUiToBuildOutput" AfterTargets="Build">
    <Copy SourceFiles="$(ConfiguratorUiTargetPath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyConfiguratorUiToPublishOutput" AfterTargets="Publish">
    <Copy SourceFiles="$(ConfiguratorUiTargetPath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
